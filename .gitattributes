# Normalize line endings. Text files are stored with LF in the repository,
# regardless of the OS that commits them. Windows checkouts still work because
# Git handles the conversion on checkout.
* text=auto eol=lf

# Explicit text types (kept for clarity; covered by the rule above).
*.ts text
*.tsx text
*.js text
*.jsx text
*.mjs text
*.cjs text
*.json text
*.css text
*.scss text
*.html text
*.md text
*.mdx text
*.txt text
*.prisma text
*.sql text
*.yml text
*.yaml text
*.sh text eol=lf
.gitignore text
.gitattributes text

# Windows scripts must keep CRLF or they can fail when executed.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never attempt to diff or merge them.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.svg text
*.bmp binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary

# Fonts are binary.
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Generated files: keep them out of language statistics, but keep diffs
# visible so lockfile changes stay reviewable.
pnpm-lock.yaml linguist-generated=true
package-lock.json linguist-generated=true
yarn.lock linguist-generated=true
tsconfig.tsbuildinfo linguist-generated=true
