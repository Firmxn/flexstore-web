# ============================================================
# FlexStore — Environment Variables Template
# Copy ke .env.local lalu isi nilai asli.
# Panduan lengkap: docs/06_SETUP_KREDENSIAL.md
# JANGAN commit .env.local (sudah ada di .gitignore).
# ============================================================

# --- Database (Supabase PostgreSQL) ---
# Supabase Dashboard > Project Settings > Database > Connection string > URI
# DATABASE_URL: connection pooler (port 6543) — dipakai aplikasi saat berjalan.
# DIRECT_URL: koneksi langsung (port 5432) — dipakai `pnpm db:migrate` / Prisma CLI.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- NextAuth v5 ---
# Generate AUTH_SECRET: npx auth secret  (atau: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Redis (Upstash) ---
# Upstash Console > Database > REST API
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Twilio (OTP via Verify API) ---
# Twilio Console > Account Info.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Verify Service SID: Console > Identity > Verify > Services > buat Service,
# salin SID-nya (`VA...`). Wajib — tanpa ini /api/otp/send menjawab 502.
TWILIO_VERIFY_SERVICE_SID=""
# Channel verifikasi: sms (dipakai proyek ini).
# Akun Trial hanya menyediakan sms/voice ke nomor yang sudah diverifikasi
# (maks 5 nomor, daftarkan di Console).
TWILIO_VERIFY_CHANNEL="sms"
# Catatan: TWILIO_PHONE_NUMBER, TWILIO_WHATSAPP_FROM, TWILIO_CONTENT_SID
# sudah dihapus — jalur Messaging API tidak lagi dipakai (docs/04 section 10).

# --- Uploadthing (image storage) ---
# Uploadthing Dashboard > API Keys
UPLOADTHING_TOKEN=""

# --- Shipping (RajaOngkir Komerce v1) ---
# Keduanya wajib untuk mode API. Kalau salah satu kosong, ongkir memakai
# fallback tarif flat Rp10.000 (SDD section 9).
# API key dari dashboard rajaongkir.komerce.id, dikirim sebagai header `key`.
RAJAONGKIR_API_KEY=""
# ID kecamatan asal toko (angka). Cari lewat /api/shipping/cities?search=...
SHIPPING_ORIGIN_DISTRICT_ID=""
# Berat paket = jumlah (kuantitas x berat varian). Berat varian diisi admin di
# form produk (kolom weightGram, default 1000 gram). Nilai ini hanya cadangan
# untuk varian yang beratnya 0/belum diisi.
SHIPPING_WEIGHT_PER_ITEM_GRAM="1000"
# Daftar kurir dipisah titik dua.
SHIPPING_COURIERS="jne:sicepat:jnt"

# --- Payment (Xendit) — dipakai mulai PH-04 ---
# Xendit Dashboard > Settings > Developers > API Keys.
# Sandbox diawali `xnd_development_`; production diawali `xnd_production_`.
XENDIT_SECRET_KEY=""
# Callback token dari Xendit Dashboard > Settings > Webhooks. Dikirim Xendit
# pada header `x-callback-token`; wajib untuk verifikasi webhook (OWASP A08).
XENDIT_WEBHOOK_TOKEN=""
# Masa bayar invoice Xendit dalam detik. Nilai yang sama dipakai sebagai batas
# reservasi stok. Contoh: 900 (15 menit), 1800 (30 menit), 3600 (1 jam).
XENDIT_INVOICE_DURATION="1800"

# --- Email (Resend) — dipakai mulai PH-05 ---
# Resend Dashboard > API Keys.
RESEND_API_KEY=""
# Alamat pengirim email. Default dev: onboarding@resend.dev (domain uji Resend,
# hanya bisa kirim ke email pemilik akun). Untuk produksi pakai domain sendiri
# yang sudah diverifikasi di Resend, contoh: FlexStore <noreply@flexstore.id>.
EMAIL_FROM=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Seed (opsional, hanya dipakai `pnpm db:seed`) ---
# Kalau SEED_ADMIN_PASSWORD kosong, seed membuat password acak dan
# mencetaknya sekali di terminal.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME=""
SEED_ADMIN_PASSWORD=""

# Akun Site Admin pertama (PH-08). Sama: password kosong = dibuat acak.
SEED_SITE_ADMIN_EMAIL=""
SEED_SITE_ADMIN_NAME=""
SEED_SITE_ADMIN_PASSWORD=""

# --- Rotasi password admin (opsional, hanya dipakai `pnpm db:reset-admin-passwords`) ---
# Untuk mengganti password akun admin yang SUDAH ada (seed tidak melakukannya).
# Isi sementara, jalankan perintah, lalu kosongkan lagi. Kedua nilai wajib berbeda
# dan minimal 12 karakter. Jangan commit nilai asli.
RESET_ADMIN_PASSWORD=""
RESET_SITE_ADMIN_PASSWORD=""

# Alternatif: biarkan dua nilai di atas kosong dan set RESET_GENERATE="true" supaya
# skrip membuat password acak (dicetak sekali di terminal).
RESET_GENERATE=""
