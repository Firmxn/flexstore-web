generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// PH-01 scope: MOD-AUTH (User), MOD-PROD (Category, Brand, Product, ProductImage, ProductVariant)
// Entity lain (Order, Payment, Voucher, dll) ditambahkan di fase berikutnya.

enum Role {
  GUEST
  CUSTOMER
  STORE_ADMIN
  SITE_ADMIN
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
  OUT_OF_STOCK
  DISCONTINUED
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String?  @unique
  phone     String?  @unique
  password  String?
  name      String
  role      Role     @default(CUSTOMER)
  // SITE-04 (PH-08): diisi saat Site Admin menonaktifkan akun. Guard dan
  // halaman terlindungi membaca ulang kolom ini supaya penonaktifan berlaku
  // segera, bukan menunggu JWT kedaluwarsa.
  deactivatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems CartItem[]
  orders    Order[]
  addresses Address[]

  notificationPreference NotificationPreference?

  @@map("users")
}

// Alamat tersimpan customer (MOD-CUST, PH-07 / PRD 4.8, 5.8). Maksimal 5 baris
// per user, ditegakkan di server saat menambah. `destinationId` menyimpan titik
// tujuan RajaOngkir supaya ongkir bisa dihitung tanpa memilih ulang. Ini snapshot
// terpisah dari `Order.shippingAddress`: mengubah alamat tidak mengubah pesanan
// lama.
model Address {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  label         String
  recipientName String
  phone         String
  destinationId String?
  province      String
  city          String
  district      String?
  subdistrict   String?
  postalCode    String?
  street        String
  note          String?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// Preferensi notifikasi customer (MOD-CUST, PH-07 / PRD 4.8). Baris dibuat saat
// customer pertama kali menyimpan preferensi; pembacaan memakai nilai bawaan
// semua aktif tanpa menulis, sama seperti StoreSetting.
model NotificationPreference {
  userId              String   @id @db.Uuid
  orderConfirmation   Boolean  @default(true)
  paymentConfirmation Boolean  @default(true)
  shippingUpdate      Boolean  @default(true)
  cancellationUpdate  Boolean  @default(true)
  refundUpdate        Boolean  @default(true)
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]

  voucherCategories VoucherCategory[]

  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]

  @@map("brands")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  slug        String        @unique
  description String?
  // PROD-07 (Media & Konten, opsional per produk): banner hero berupa video
  // (plus kontrol autoplay) ATAU gambar, serta narasi ProductStory (fallback
  // bila kosong = description).
  videoHeroUrl       String?
  videoHeroAutoplay  Boolean   @default(true)
  heroImageUrl       String?
  storyText          String?
  status      ProductStatus @default(DRAFT)
  totalStock  Int           @default(0)
  // Harga varian termurah, denormalisasi dari ProductVariant supaya katalog
  // bisa mengurutkan berdasarkan harga (Prisma tidak mendukung orderBy agregat
  // relasi). Disinkronkan setiap kali produk dibuat/diubah.
  minPrice    Decimal       @default(0) @db.Decimal(12, 2)
  categoryId  String        @db.Uuid
  brandId     String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category Category         @relation(fields: [categoryId], references: [id])
  brand    Brand?           @relation(fields: [brandId], references: [id])
  images   ProductImage[]
  variants ProductVariant[]

  voucherProducts VoucherProduct[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([status, minPrice])
  @@map("products")
}

model ProductImage {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @db.Uuid
  url       String
  role      ImageRole @default(GALLERY)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  sku        String   @unique
  name       String
  price      Decimal  @db.Decimal(10, 2)
  stock      Int      @default(0)
  // Berat aktual varian dalam gram, diisi admin di form produk. Dipakai server
  // untuk menghitung berat paket (bukan dari input klien) dan tidak ditampilkan
  // ke customer/guest. Default 1000 gram untuk data lama.
  weightGram Int      @default(1000)
  imageUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

// Keranjang Customer (MOD-CART, PH-02). Guest disimpan di Redis
// (`cart:guest:{sessionId}`), bukan di tabel ini.
// `price` adalah snapshot harga saat item ditambahkan; harga live divalidasi
// ulang saat checkout (PH-03).
model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  variantId String   @db.Uuid
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@index([userId])
  @@map("cart_items")
}

// Pesanan (MOD-ORDER, PH-03). Dibuat tanpa baris Payment (PH-04) dan tanpa
// voucher (PH-05). Stok dikurangi saat pesanan dibuat (reservasi) dan
// dikembalikan bila `stockReservedUntil` terlewat tanpa pembayaran.
enum OrderStatus {
  WAITING_PAYMENT
  PROCESSING
  SHIPPED
  COMPLETED
  // Pembeli mengajukan pembatalan; menunggu tinjauan Store Admin (PRD 5.5).
  CANCEL_REQUESTED
  CANCELED
}

// Cara pemenuhan pesanan (PRD 3.1.F). PICKUP tidak dikenai ongkir.
enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

enum RefundMethod {
  AUTOMATIC
  MANUAL
}

// Status refund terpisah dari status pesanan (PRD 5.6 butir 3).
enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

// Peran gambar produk (PRD 3.1.A/7.4): galeri utama atau bagan ukuran.
// PROD-07: STORY (maks 1) dan LOOKBOOK (maks 4) untuk seksi Media & Konten.
enum ImageRole {
  GALLERY
  SIZE_CHART
  STORY
  LOOKBOOK
}

model Order {
  id                 String      @id @default(uuid()) @db.Uuid
  orderNumber        String      @unique
  userId             String?     @db.Uuid
  guestPhone         String?
  guestEmail         String?
  status             OrderStatus @default(WAITING_PAYMENT)
  subtotal           Decimal     @db.Decimal(12, 2)
  shippingCost       Decimal     @db.Decimal(12, 2)
  discount           Decimal     @db.Decimal(12, 2) @default(0)
  total              Decimal     @db.Decimal(12, 2)
  shippingAddress    Json
  shippingCourier    String?
  shippingService    String?
  shippingEtd        String?
  stockReservedUntil DateTime?
  // Pemenuhan pesanan (PH-06): DELIVERY memakai ongkir, PICKUP tidak.
  fulfillment        FulfillmentMethod @default(DELIVERY)
  // Nomor resi dari admin saat status menjadi SHIPPED (ORDER-07/SHIP-02).
  trackingNumber     String?
  shippedAt          DateTime?
  completedAt        DateTime?
  // Alur pembatalan (ORDER-05/PRD 5.5): alasan dari pembeli + alasan penolakan
  // admin (template atau manual).
  cancelRequestedAt  DateTime?
  cancelReason       String?
  cancelRejectionReason String?
  canceledAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user          User?           @relation(fields: [userId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  payment       Payment?
  refunds       Refund[]
  voucherUsages VoucherUsage[]

  @@index([userId])
  @@index([status, stockReservedUntil])
  @@index([guestPhone])
  @@index([status, createdAt])
  @@map("orders")
}

// Pembayaran (MOD-PAY, PH-04). Satu pesanan satu baris Payment (Xendit Invoice
// API). `externalId` = nomor pesanan, dipakai Xendit sebagai `external_id`.
// Stok TIDAK dikurangi lagi saat webhook PAID: reservasi sudah terjadi saat
// pesanan dibuat (PH-03); pembayaran hanya mengubah status.
enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

model Payment {
  id         String        @id @default(uuid()) @db.Uuid
  orderId    String        @unique @db.Uuid
  provider   String        @default("XENDIT")
  externalId String        @unique
  invoiceId  String?
  invoiceUrl String?
  amount     Decimal       @db.Decimal(12, 2)
  status     PaymentStatus @default(PENDING)
  paidAt     DateTime?
  expiresAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payments")
}

// Baris pesanan menyimpan snapshot nama, SKU, harga, dan berat agar riwayat
// tidak berubah saat produk/varian disunting. `variantId` dipertahankan
// (Restrict) supaya produk yang pernah dipesan tidak bisa dihapus.
model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  variantId   String   @db.Uuid
  productName String
  variantName String
  sku         String
  price       Decimal  @db.Decimal(12, 2)
  quantity    Int
  weightGram  Int
  createdAt   DateTime @default(now())

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

// Voucher (MOD-VOUCH, PH-05). Kalkulasi bertahap (nominal dulu, baru persentase)
// dihitung di server; `Order.discount` menyimpan total potongan yang benar-benar
// dipakai. `VoucherUsage` adalah catatan pemakaian (kuota total dan per nomor HP).
enum VoucherType {
  PERCENTAGE
  NOMINAL
  SHIPPING
}

model Voucher {
  id                 String      @id @default(uuid()) @db.Uuid
  code               String      @unique
  type               VoucherType
  // PERCENTAGE: discountPercentage (mis. 10 = 10%), dibatasi maxDiscount.
  // NOMINAL: discountAmount. SHIPPING: discountAmount memotong ongkir.
  discountPercentage Decimal?    @db.Decimal(5, 2)
  discountAmount     Decimal?    @db.Decimal(12, 2)
  maxDiscount        Decimal?    @db.Decimal(12, 2)
  minTransaction     Decimal     @default(0) @db.Decimal(12, 2)
  // null = tanpa batas.
  usageLimit         Int?
  usageCount         Int         @default(0)
  usageLimitPerPhone Int?
  validFrom          DateTime
  validUntil         DateTime
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  compatibilitiesAsA VoucherCompatibility[] @relation("VoucherA")
  compatibilitiesAsB VoucherCompatibility[] @relation("VoucherB")
  usages             VoucherUsage[]
  products           VoucherProduct[]
  categories         VoucherCategory[]

  @@index([isActive, validFrom, validUntil])
  @@map("vouchers")
}

// Matriks kompatibilitas stacking (PRD 5.4). Baris hanya dibuat untuk pasangan
// yang eksplisit diatur admin; pasangan tanpa baris dianggap TIDAK kompatibel
// (default menolak, seller-oriented).
model VoucherCompatibility {
  id         String   @id @default(uuid()) @db.Uuid
  voucherAId String   @db.Uuid
  voucherBId String   @db.Uuid
  isAllowed  Boolean
  createdAt  DateTime @default(now())

  voucherA Voucher @relation("VoucherA", fields: [voucherAId], references: [id], onDelete: Cascade)
  voucherB Voucher @relation("VoucherB", fields: [voucherBId], references: [id], onDelete: Cascade)

  @@unique([voucherAId, voucherBId])
  @@index([voucherBId])
  @@map("voucher_compatibilities")
}

model VoucherUsage {
  id        String   @id @default(uuid()) @db.Uuid
  voucherId String   @db.Uuid
  orderId   String   @db.Uuid
  phone     String?
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([voucherId, orderId])
  @@index([voucherId])
  @@index([phone])
  @@map("voucher_usages")
}

// Refund (MOD-ORDER, PH-06 / PRD 5.6). Status refund terpisah dari status
// pesanan; bukti refund manual wajib tersimpan supaya dapat ditelusuri.
model Refund {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @db.Uuid
  amount      Decimal      @db.Decimal(12, 2)
  method      RefundMethod @default(MANUAL)
  status      RefundStatus @default(PENDING)
  proofUrl    String?
  note        String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("refunds")
}

// Pengaturan toko (MOD-CONFIG, PH-06 / PRD 4.12). Baris tunggal dengan id tetap.
// Tanpa "storeName": 1 deployment = 1 brand = 1 store — identitas memakai
// BrandSetting.brandName (SITE-05). Label pickup di checkout memakai brandName.
model StoreSetting {
  id              String   @id @default("default")
  storeEmail      String?
  storePhone      String?
  storeAddress    String?
  aboutUs         String?
  returnPolicy    String?
  warrantyPolicy  String?
  // Pickup (SHIP-03): hanya tampil di checkout bila diaktifkan.
  pickupEnabled   Boolean  @default(false)
  pickupInfo      String?
  socialInstagram String?
  socialFacebook  String?
  socialWhatsapp  String?
  updatedAt       DateTime @updatedAt

  @@map("store_settings")
}

// SITE-02 (PH-08): mode pembayaran yang ditampilkan/dicatat Site Admin.
// Xendit memakai base URL yang sama; sandbox vs produksi dibedakan oleh kunci
// di env, jadi kolom ini bersifat label/jejak audit.
enum PlatformPaymentMode {
  SANDBOX
  PRODUCTION
}

// SITE-01..SITE-03 (PH-08): konfigurasi level platform. Rahasia (kunci Xendit,
// kunci RajaOngkir) TIDAK disimpan di sini, melainkan tetap di env (OWASP A02).
// Satu baris tetap `id = "default"`, pola sama seperti StoreSetting.
model PlatformSetting {
  id                        String              @id @default("default")
  // SITE-01: mode pemeliharaan + status pendaftaran publik.
  maintenanceMode           Boolean             @default(false)
  maintenanceMessage        String?
  registrationEnabled       Boolean             @default(true)
  // SITE-02: perilaku pembayaran Xendit.
  paymentEnabled            Boolean             @default(true)
  paymentMode               PlatformPaymentMode  @default(SANDBOX)
  invoiceDurationSeconds    Int                 @default(900)
  // SITE-03: perilaku perhitungan ongkir RajaOngkir.
  shippingEnabled           Boolean             @default(true)
  shippingOriginDistrictId  String?
  shippingCouriers          String              @default("jne:sicepat:jnt")
  shippingWeightPerItemGram Int                 @default(1000)
  shippingFlatRateIdr       Int                 @default(10000)
  updatedAt                 DateTime            @updatedAt

  @@map("platform_settings")
}

// SITE-05 (PH-09): identitas brand per deployment (1 deployment = 1 brand
// store). Satu baris tetap `id = "default"`, pola sama seperti StoreSetting dan
// PlatformSetting. Semua kolom tampilan nullable; `null` berarti memakai nilai
// bawaan (nama "FlexStore", tagline `siteDescription`, palet oklch di
// globals.css, hero teks default), sehingga tanpa baris tampilan tidak berubah.
// Warna disimpan sebagai hex `#RRGGBB` hasil validasi Zod.
model BrandSetting {
  id         String  @id @default("default")
  brandName  String  @default("FlexStore")
  tagline    String?
  logoUrl    String?
  faviconUrl String?
  footerText String?

  // Palet warna (9 grup inti; token card/popover/input/ring tetap bawaan).
  primaryColor     String?
  primaryFg        String?
  secondaryColor   String?
  secondaryFg      String?
  accentColor      String?
  accentFg         String?
  backgroundColor  String?
  foregroundColor  String?
  mutedColor       String?
  mutedFg          String?
  borderColor      String?
  destructiveColor String?
  destructiveFg    String?
  successColor     String?
  successFg        String?

  // Banner homepage (hero). `bannerEnabled = false` memakai hero teks default.
  bannerEnabled     Boolean @default(false)
  bannerImageUrl    String?
  bannerTitle       String?
  bannerText        String?
  bannerButtonLabel String?
  bannerButtonHref  String?

  updatedAt DateTime @updatedAt

  @@map("brand_settings")
}

// Template alasan penolakan pembatalan (MOD-CONFIG, PH-06 / PRD 5.5).
model CancellationReason {
  id        String   @id @default(uuid()) @db.Uuid
  text      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cancellation_reasons")
}

// Cakupan voucher per produk/kategori (PRD 5.4 butir 1-3). Tanpa baris apa pun,
// voucher berlaku untuk seluruh produk (perilaku PH-05).
enum VoucherProductKind {
  ELIGIBLE
  EXCLUDED
}

model VoucherProduct {
  voucherId String             @db.Uuid
  productId String             @db.Uuid
  // ELIGIBLE: hanya produk ini yang dicakup. EXCLUDED: produk ini dikecualikan.
  kind      VoucherProductKind @default(ELIGIBLE)
  createdAt DateTime           @default(now())

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([voucherId, productId])
  @@index([productId])
  @@map("voucher_products")
}

model VoucherCategory {
  voucherId  String   @db.Uuid
  categoryId String   @db.Uuid
  createdAt  DateTime @default(now())

  voucher  Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([voucherId, categoryId])
  @@index([categoryId])
  @@map("voucher_categories")
}
