generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// PH-01 scope: MOD-AUTH (User), MOD-PROD (Category, Brand, Product, ProductImage, ProductVariant)
// Entity lain (Order, Payment, Voucher, dll) ditambahkan di fase berikutnya.

enum Role {
  GUEST
  CUSTOMER
  STORE_ADMIN
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
  OUT_OF_STOCK
  DISCONTINUED
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String?  @unique
  phone     String?  @unique
  password  String?
  name      String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems CartItem[]
  orders    Order[]

  @@map("users")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]

  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]

  @@map("brands")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  slug        String        @unique
  description String?
  status      ProductStatus @default(DRAFT)
  totalStock  Int           @default(0)
  categoryId  String        @db.Uuid
  brandId     String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category Category         @relation(fields: [categoryId], references: [id])
  brand    Brand?           @relation(fields: [brandId], references: [id])
  images   ProductImage[]
  variants ProductVariant[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  sku        String   @unique
  name       String
  price      Decimal  @db.Decimal(10, 2)
  stock      Int      @default(0)
  // Berat aktual varian dalam gram, diisi admin di form produk. Dipakai server
  // untuk menghitung berat paket (bukan dari input klien) dan tidak ditampilkan
  // ke customer/guest. Default 1000 gram untuk data lama.
  weightGram Int      @default(1000)
  imageUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

// Keranjang Customer (MOD-CART, PH-02). Guest disimpan di Redis
// (`cart:guest:{sessionId}`), bukan di tabel ini.
// `price` adalah snapshot harga saat item ditambahkan; harga live divalidasi
// ulang saat checkout (PH-03).
model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  variantId String   @db.Uuid
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@index([userId])
  @@map("cart_items")
}

// Pesanan (MOD-ORDER, PH-03). Dibuat tanpa baris Payment (PH-04) dan tanpa
// voucher (PH-05). Stok dikurangi saat pesanan dibuat (reservasi) dan
// dikembalikan bila `stockReservedUntil` terlewat tanpa pembayaran.
enum OrderStatus {
  WAITING_PAYMENT
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELED
}

model Order {
  id                 String      @id @default(uuid()) @db.Uuid
  orderNumber        String      @unique
  userId             String?     @db.Uuid
  guestPhone         String?
  guestEmail         String?
  status             OrderStatus @default(WAITING_PAYMENT)
  subtotal           Decimal     @db.Decimal(12, 2)
  shippingCost       Decimal     @db.Decimal(12, 2)
  discount           Decimal     @db.Decimal(12, 2) @default(0)
  total              Decimal     @db.Decimal(12, 2)
  shippingAddress    Json
  shippingCourier    String?
  shippingService    String?
  shippingEtd        String?
  stockReservedUntil DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user          User?           @relation(fields: [userId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  payment       Payment?
  voucherUsages VoucherUsage[]

  @@index([userId])
  @@index([status, stockReservedUntil])
  @@index([guestPhone])
  @@map("orders")
}

// Pembayaran (MOD-PAY, PH-04). Satu pesanan satu baris Payment (Xendit Invoice
// API). `externalId` = nomor pesanan, dipakai Xendit sebagai `external_id`.
// Stok TIDAK dikurangi lagi saat webhook PAID: reservasi sudah terjadi saat
// pesanan dibuat (PH-03); pembayaran hanya mengubah status.
enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

model Payment {
  id         String        @id @default(uuid()) @db.Uuid
  orderId    String        @unique @db.Uuid
  provider   String        @default("XENDIT")
  externalId String        @unique
  invoiceId  String?
  invoiceUrl String?
  amount     Decimal       @db.Decimal(12, 2)
  status     PaymentStatus @default(PENDING)
  paidAt     DateTime?
  expiresAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payments")
}

// Baris pesanan menyimpan snapshot nama, SKU, harga, dan berat agar riwayat
// tidak berubah saat produk/varian disunting. `variantId` dipertahankan
// (Restrict) supaya produk yang pernah dipesan tidak bisa dihapus.
model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  variantId   String   @db.Uuid
  productName String
  variantName String
  sku         String
  price       Decimal  @db.Decimal(12, 2)
  quantity    Int
  weightGram  Int
  createdAt   DateTime @default(now())

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

// Voucher (MOD-VOUCH, PH-05). Kalkulasi bertahap (nominal dulu, baru persentase)
// dihitung di server; `Order.discount` menyimpan total potongan yang benar-benar
// dipakai. `VoucherUsage` adalah catatan pemakaian (kuota total dan per nomor HP).
enum VoucherType {
  PERCENTAGE
  NOMINAL
  SHIPPING
}

model Voucher {
  id                 String      @id @default(uuid()) @db.Uuid
  code               String      @unique
  type               VoucherType
  // PERCENTAGE: discountPercentage (mis. 10 = 10%), dibatasi maxDiscount.
  // NOMINAL: discountAmount. SHIPPING: discountAmount memotong ongkir.
  discountPercentage Decimal?    @db.Decimal(5, 2)
  discountAmount     Decimal?    @db.Decimal(12, 2)
  maxDiscount        Decimal?    @db.Decimal(12, 2)
  minTransaction     Decimal     @default(0) @db.Decimal(12, 2)
  // null = tanpa batas.
  usageLimit         Int?
  usageCount         Int         @default(0)
  usageLimitPerPhone Int?
  validFrom          DateTime
  validUntil         DateTime
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  compatibilitiesAsA VoucherCompatibility[] @relation("VoucherA")
  compatibilitiesAsB VoucherCompatibility[] @relation("VoucherB")
  usages             VoucherUsage[]

  @@index([isActive, validFrom, validUntil])
  @@map("vouchers")
}

// Matriks kompatibilitas stacking (PRD 5.4). Baris hanya dibuat untuk pasangan
// yang eksplisit diatur admin; pasangan tanpa baris dianggap TIDAK kompatibel
// (default menolak, seller-oriented).
model VoucherCompatibility {
  id         String   @id @default(uuid()) @db.Uuid
  voucherAId String   @db.Uuid
  voucherBId String   @db.Uuid
  isAllowed  Boolean
  createdAt  DateTime @default(now())

  voucherA Voucher @relation("VoucherA", fields: [voucherAId], references: [id], onDelete: Cascade)
  voucherB Voucher @relation("VoucherB", fields: [voucherBId], references: [id], onDelete: Cascade)

  @@unique([voucherAId, voucherBId])
  @@index([voucherBId])
  @@map("voucher_compatibilities")
}

model VoucherUsage {
  id        String   @id @default(uuid()) @db.Uuid
  voucherId String   @db.Uuid
  orderId   String   @db.Uuid
  phone     String?
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([voucherId, orderId])
  @@index([voucherId])
  @@index([phone])
  @@map("voucher_usages")
}
